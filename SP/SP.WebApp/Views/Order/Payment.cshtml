@model SP.Application.Dto.OrderDto.OrderViewDto

@{
    ViewData["Title"] = "Thanh Toán Đơn Hàng";
}

<h2>🧾 Thanh toán đơn hàng</h2>

<div class="card">
    <div class="card-body">
        <h5>Mã đơn hàng: @Model.Id</h5>
        <p>Ngày tạo: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
        <p>Trạng thái: <strong>@Model.Status</strong></p>

        <table class="table mt-3">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Số lượng</th>
                    <th>Đơn giá</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderDetails)
                {
                    <tr>
                        <td>@item.ProductVariant.ProductName</td>
                        <td>@item.Quantity</td>
                        <td>@String.Format("{0:N0} ₫", item.Price)</td>
                    </tr>
                }
            </tbody>
        </table>

        <p class="text-end fw-bold">
            Tổng tiền:
            @String.Format("{0:N0} ₫", Model.OrderDetails.Sum(x => x.Price * x.Quantity))
        </p>

        <form asp-action="ConfirmPayment" asp-route-orderId="@Model.Id" method="post">
            <button type="submit" class="btn btn-success">Xác nhận thanh toán</button>
        </form>
    </div>
</div>
