        }

        .product-specs {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 15px;
        }

        .specs-item {
            display: contents;
        }

        .specs-title {
            font-weight: 600;
            color: var(--secondary-color);
        }

        .specs-value {
            color: var(--dark-gray);
        }

        .no-reviews {
            color: var(--dark-gray);
            font-style: italic;
        }

        @@media (max-width: 768px) {
            .product-main {
                flex-direction: column;
            }

            .product-gallery {
                max-width: 100%;
            }

            .product-actions {
                flex-direction: column;
            }
        }
    </style>
}

@section Scripts {
    <script>
        const variants = @Html.Raw(Json.Serialize(Model.ProductVariants));
        const colorMap = @Html.Raw(Json.Serialize(colorMap)); // Serialize the color map for JavaScript

        const imageElem = document.getElementById('productImage');
        const priceElem = document.getElementById('priceDisplay');
        const variantIdInput = document.getElementById('selectedVariantId');
        const variantIdInput2 = document.getElementById('selectedVariantId2');
        const thumbnailContainer = document.querySelector('.thumbnail-scroller');
        const priceContainer = document.querySelector('.product-price-container');

        // Initialize selected options
        let selectedSize = '@defaultVariant?.Size' || null;
        let selectedColor = '@defaultVariant?.Color' || null;

        // Color selection
        document.querySelectorAll('.color-option').forEach(option => {
            option.addEventListener('click', () => {
                document.querySelectorAll('.color-option').forEach(opt => opt.classList.remove('active'));
                option.classList.add('active');
                selectedColor = option.getAttribute('data-value'); // Use English color for logic

                // Find available sizes for the selected color
                const availableSizes = getAvailableSizes(selectedColor);
                updateSizeOptions(availableSizes);

                // If current size is not available with the new color, select the first available size
                if (availableSizes.length > 0 && !availableSizes.includes(selectedSize)) {
                    selectedSize = availableSizes[0];
                    updateActiveSizeOption(selectedSize);
                }

                updateVariant();
            });
        });

        // Size selection (unchanged)
        document.querySelectorAll('.size-option').forEach(option => {
            option.addEventListener('click', () => {
                document.querySelectorAll('.size-option').forEach(opt => opt.classList.remove('active'));
                option.classList.add('active');
                selectedSize = option.getAttribute('data-value');
                updateVariant();
            });
        });

        // Get available sizes for the selected color
        function getAvailableSizes(color) {
            return [...new Set(variants
                .filter(v => v.color === color)
                .map(v => v.size))];
        }

        // Update size options display
        function updateSizeOptions(availableSizes) {
            const sizeOptions = document.querySelectorAll('.size-option');
            sizeOptions.forEach(option => {
                const size = option.getAttribute('data-value');
                if (availableSizes.includes(size)) {
                    option.style.display = 'block';
                    option.classList.remove('disabled');
                } else {
                    option.style.display = 'none';
                    option.classList.add('disabled');
                }
            });
        }

        // Update active size option
        function updateActiveSizeOption(size) {
            document.querySelectorAll('.size-option').forEach(option => {
                option.classList.remove('active');
                if (option.getAttribute('data-value') === size) {
                    option.classList.add('active');
                }
            });
        }

        // Update variant based on selected options
        function updateVariant() {
            if (!selectedSize || !selectedColor) return;

            // Find matching variant
            const matchedVariant = variants.find(v =>
                v.size === selectedSize &&
                v.color === selectedColor
            );

            if (matchedVariant) {
                // Update price
                updatePriceDisplay(matchedVariant.price, @Model.Percent);

                // Update main image if available
                if (matchedVariant.images && matchedVariant.images.length > 0) {
                    const firstImage = matchedVariant.images[0];
                    imageElem.src = `data:${firstImage.contentType};base64,${firstImage.fileData}`;
                    imageElem.style.display = 'block';

                    // Update thumbnails
                    updateThumbnails(matchedVariant.images);
                } else {
                    imageElem.style.display = 'none';
                }

                // Update variant ID in forms
                document.getElementById('selectedVariantId').value = matchedVariant.id;
                document.getElementById('selectedVariantId2').value = matchedVariant.id;
            } else {
                // Show message if no matching variant
                priceContainer.innerHTML = `
                    <div class="text-danger">Sản phẩm với màu và kích thước đã chọn hiện không có sẵn</div>
                `;

                // Hide product image
                imageElem.style.display = 'none';

                // Clear thumbnails
                thumbnailContainer.innerHTML = '';

                // Clear variant ID
                document.getElementById('selectedVariantId').value = '';
                document.getElementById('selectedVariantId2').value = '';
            }
        }

        // Update price display
        function updatePriceDisplay(price, discountPercent) {
            const priceContent = document.getElementById('priceContent');

            if (discountPercent > 0) {
                const discountAmount = (price * discountPercent) / 100;
                const discountedPrice = price - discountAmount;
                priceContent.innerHTML = `
                            <div class="current-price fw-bold text-danger" style="font-size: 1.5rem;">
                                ${discountedPrice.toLocaleString('vi-VN')} đ
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <div class="original-price text-muted" style="text-decoration: line-through;">
                                    ${price.toLocaleString('vi-VN')} đ
                                </div>
                                <span class="badge bg-danger text-white ml-2">-${discountPercent}%</span>
                            </div>
                        `;
            } else {
                priceContent.innerHTML = `
                            <div class="current-price fw-bold">
                                ${price.toLocaleString('vi-VN')} đ
                            </div>
                        `;
            }
        }

        // Update thumbnails
        function updateThumbnails(images) {
            thumbnailContainer.innerHTML = '';

            images.forEach(img => {
                const thumbSrc = `data:${img.contentType};base64,${img.fileData}`;
                const thumbItem = document.createElement('div');
                thumbItem.className = 'thumbnail-item';

                const thumbImg = document.createElement('img');
                thumbImg.src = thumbSrc;
                thumbImg.className = 'thumbnail-image';
                thumbImg.addEventListener('click', () => {
                    imageElem.src = thumbImg.src;
                });

                thumbItem.appendChild(thumbImg);
                thumbnailContainer.appendChild(thumbItem);
            });
        }

        // Thumbnail click event delegation
        thumbnailContainer.addEventListener('click', (e) => {
            if (e.target.classList.contains('thumbnail-image')) {
                imageElem.src = e.target.src;
            }
        });

        // Quantity controls
        quantityInput.addEventListener('input', () => {
            if (quantityInput.value === '' || parseInt(quantityInput.value) < 1) {
                quantityInput.value = 1;
            }
            // Update quantity in forms
            document.getElementById('addToCartQuantity').value = quantityInput.value;
            document.getElementById('buyNowQuantity').value = quantityInput.value;
        });

        // Cũng cần cập nhật trong sự kiện tăng/giảm số lượng
        btnDecrease.addEventListener('click', () => {
            let currentValue = parseInt(quantityInput.value) || 1;
            if (currentValue > 1) {
                quantityInput.value = currentValue - 1;
                document.getElementById('addToCartQuantity').value = quantityInput.value;
                document.getElementById('buyNowQuantity').value = quantityInput.value;
            }
        });

        btnIncrease.addEventListener('click', () => {
            let currentValue = parseInt(quantityInput.value) || 1;
            quantityInput.value = currentValue + 1;
            document.getElementById('addToCartQuantity').value = quantityInput.value;
            document.getElementById('buyNowQuantity').value = quantityInput.value;
        });

       
    </script>
}