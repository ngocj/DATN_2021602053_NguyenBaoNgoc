        }

        .nav-link {
            color: var(--secondary-color);
            font-weight: 600;
            padding: 12px 20px;
            border: none;
            border-bottom: 3px solid transparent;
        }

        .nav-link.active {
            color: var(--primary-color);
            background: none;
            border-bottom: 3px solid var(--primary-color);
        }

        .nav-link:hover {
            color: var(--primary-color);
            border-color: transparent;
        }

        .tab-content {
